ACTIVITY UC08 — Tìm kiếm
PARTITION actor = {User, System*}

START                                          @User
[Chọn chức năng Tìm kiếm]                      @User
[Hiển thị ô nhập]


L1: [Nhập từ khóa hoặc mã số hiện vật]         @User
    IF (Từ khóa rỗng?) THEN
        [Yêu cầu người dùng nhập từ khóa hoặc mã]
        GOTO L1

    [Tìm trong CSDL]
    IF !(Có kq?) THEN
        [Báo không tìm thấy]
        FINAL

    [Trả về kết quả tìm kiếm]
    FINAL
