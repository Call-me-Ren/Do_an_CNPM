ACTIVITY UC07 — Xem phụ đề đồng bộ
PARTITION actor = {Visitor, System*}

START                                          @Visitor
[Chọn chức năng xem phụ đề]                    @Visitor
[Xác định ngôn ngữ]
[Truy vấn phụ đề]
IF !(Có phụ đề?) THEN
    [Báo không có phụ đề]
    FINAL

[Hiển thị phụ đề]


L1: [Cập nhật phụ đề]
    IF (Đổi ngôn ngữ?) THEN
        [Hiển thị phụ đề mới]
        GOTO L1

    [Hiển thị phụ đề đồng bộ karaoke theo âm thanh]
    FINAL
