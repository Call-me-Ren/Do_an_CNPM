' ============================================================
' MUSEUM MULTILINGUAL SMART AUDIO GUIDE SYSTEM
' STANDARDIZED FINAL USE CASE DIAGRAM (UML 2.5) — 14 CORE USE CASES
' Minimalist style, conforming to UML 2.5 standards
' 100% aligned with Web SPA, Offline-First Android App, and MSSQL Backend
' ============================================================

' ---------- General Overview ----------
@startuml General
title Final General Use Case Diagram (14 Core Use Cases) — Museum Multilingual Smart Audio Guide System
!pragma layout smetana
left to right direction
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam roundCorner 8
skinparam shadowing false
skinparam nodesep 28
skinparam ranksep 60

actor "Visitor" as Visitor
actor "System Administrator (Admin)" as Admin
actor "GPS Positioning System" as GpsSystem
actor "Audio System" as AudioSystem

rectangle "Museum Multilingual Smart Audio Guide System" {
  ' --- Visitor Subsystem (No Authentication Required)
  together {
    usecase "Scan QR Code" as UC02
    usecase "Listen to Audio Guide" as UC03
    usecase "Switch Language" as UC04
    usecase "Save Favorite Artifacts" as UC05
    usecase "View Museum Information" as UC06
    usecase "View Synchronized Subtitles" as UC07
    usecase "Search Artifacts" as UC08
    usecase "Geofencing & Auto Guide" as UC14
  }

  ' --- Administrative Authentication Gateway
  usecase "Admin Authentication" as UC01

  ' --- Admin CMS Subsystem (Authentication Required)
  together {
    usecase "Manage Artifacts" as UC09
    usecase "Manage Sessions & QR Codes" as UC10
    usecase "Manage Audio Files" as UC11
    usecase "View Listening Analytics" as UC12
    usecase "Manage Floor Maps" as UC13
  }
}

' ---- Visitor Actor Associations
Visitor -- UC02
Visitor -- UC03
Visitor -- UC04
Visitor -- UC05
Visitor -- UC06
Visitor -- UC08
Visitor -- UC14

' ---- Admin Actor Associations
Admin -- UC01
Admin -- UC09
Admin -- UC10
Admin -- UC11
Admin -- UC12
Admin -- UC13

' ---- External System Actors
GpsSystem -- UC14
AudioSystem -- UC03

' ---- <<include>> Relationships
UC09 ..> UC01 : <<include>>
UC10 ..> UC01 : <<include>>
UC11 ..> UC01 : <<include>>
UC12 ..> UC01 : <<include>>
UC13 ..> UC01 : <<include>>

' ---- <<extend>> Relationships
UC07 ..> UC03 : <<extend>>
UC14 ..> UC03 : <<extend>>

@enduml

