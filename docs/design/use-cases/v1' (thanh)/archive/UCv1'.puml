' ---------- UC09_activity ----------
@startuml UC09_activity
title UC09 - Quản lý sự vật
start
:Admin chọn chức năng đăng nhập;
:Hệ thống chào mừng đăng nhập cùng với hiển thị chức năng;
:Admin chọn quản lý sự vật;
:Hệ thống hiển thị danh sách chức năng;
repeat
  :Chọn thao tác;
  if (Chọn xóa?) then ([Có])
    :Hiển thị hộp thoại xác nhận;
    :Xóa và báo thành công;
  else ([Không])
    if (Chọn sửa?) then ([Có])
    else ([Không])
      if (Chọn thêm mới?) then ([Có])
      else ([Không])
        stop
      endif
    endif
    :Hiển thị biểu mẫu;
    repeat
      :Điền thông tin;
      if (Nhấn hủy?) then ([Có])
        break
      else ([Không])
      endif
      if (Đủ trường?) then ([Không])
        :Báo lỗi thiếu trường;
      else ([Có])
        if (Mã số trùng?) then ([Có])
          :Báo lỗi trùng mã;
        else ([Không])
          if (Lưu được?) then ([Không])
            :Báo lỗi không lưu được;
          else ([Có])
            stop
          endif
        endif
      endif
    repeat while (Nhập lại?) is (Lỗi)
  endif
repeat while (Quay lại chọn thao tác?)
stop
@enduml

