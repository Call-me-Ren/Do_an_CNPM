' ---------- UC02_activity ----------
@startuml UC02_activity
title UC02 - Quét mã QR
start
:Người dùng chọn chức năng quét mã QR;
:Hệ thống thông báo kích hoạt camera và hiển thị khung quét;
if (Bật camera?) then ([Có])
  repeat
    :Người dùng hướng camera về phía mã QR;
    :Hệ thống nhận diện và giải mã chuỗi định danh QR;
  backward :Hiển thị thông báo không quét được mã QR;
  repeat while (Nhận diện được?) is ([Không]) not ([Có])
  :Mở chi tiết hiện vật;
  repeat
    repeat
      :Hệ thống tự động tracking vị trí;
      if (Mất tín hiệu?) then ([Có])
        :Thông báo mất tracking, gợi ý quét thủ công;
        stop
      else ([Không])
      endif
    backward :Tự động thuyết minh hiện vật mới;
    repeat while (Gần hiện vật mới?) is ([Có]) not ([Không])
  repeat while (Người dùng dừng?) is ([Không]) not ([Có])
  :Kết thúc hệ thống;
else ([Không])
endif
stop
@enduml

