@startuml UC10_activity
title UC10 - Quản lý phiên
start
:Admin chọn chức năng đăng nhập;
:Hệ thống chào mừng đăng nhập cùng với hiển thị chức năng;
:Admin chọn Quản lý phiên;
repeat
  :Tải danh sách phiên;
backward :Báo lỗi tải;
repeat while (Tải được?) is ([Không]) not ([Có])
if (Đến giờ chuyển?) then ([Có])
  :Tự đổi trạng thái;
endif
:Hiển thị danh sách;

repeat
  :Chọn thao tác;
  if (Chọn xóa?) then ([Có])
    :Hiển thị hộp thoại xác nhận;
    :Xóa và báo thành công;
    :Tải lại danh sách;
  elseif (Chọn sửa hoặc thêm mới?) then ([Có])
    :Hiển thị biểu mẫu;
    repeat
      :Điền thông tin;
      if (Nhấn hủy?) then ([Có])
        break
      endif
      if (Hợp lệ?) then ([Có])
        :Cập nhật danh sách phiên;
        break
      else ([Không])
        :Báo lỗi;
      endif
    repeat while (Nhập lại?) is ([Có]) not ([Không])
  else ([Thoát])
    stop
  endif
repeat while (Tiếp tục?) is ([Có]) not ([Không])
stop
@enduml

@startuml
start
:Admin chọn quản lý phiên;

repeat
  :Tải danh sách phiên;
backward :Báo lỗi tải;
repeat while (Tải được?) is (không) not (có)

if (Đến giờ chuyển?) then (có)
  :Tự đổi trạng thái;
endif

repeat
  :Hiển thị danh sách;
  :Admin chọn thao tác;
  if (Admin chọn xóa, sửa hoặc thêm mới?) then (không)
    stop
  endif
  if (Admin chọn xóa?) then (có)
    :Hiển thị hộp thoại xác nhận;
    if (Admin xác nhận xóa?) then (có)
      :Xóa phiên;
      if (Xóa lỗi?) then (có)
        :Báo lỗi xóa;
      else (không)
        :Báo xóa thành công;
      endif
    else (không)
    endif
  else (không)
    :Hiển thị biểu mẫu;
    :Admin điền thông tin;
    while (Admin nhấn hủy?) is (không)
      if (Dữ liệu hợp lệ?) then (có)
        :Lưu phiên;
        if (Lưu lỗi?) then (có)
          :Báo lỗi lưu;
        else (không)
          :Báo lưu thành công;
          :Hệ thống cập nhật danh sách phiên;
          stop
        endif
      else (không)
        :Báo lỗi trường nhập;
      endif
    backward :Admin điền thông tin;
    endwhile (có)
  endif
repeat while
@enduml

