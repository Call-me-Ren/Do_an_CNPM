repeat
  :Tải danh sách phiên;
backward :Báo lỗi tải;
repeat while (Tải được?) is ([Không]) not ([Có])
if (Đến giờ chuyển?) then ([Có])
  :Tự đổi trạng thái;
else ([Không])
endif
:Hiển thị danh sách;
:Chọn thao tác;
while (Chọn xóa?) is ([Có])
  :Hiển thị hộp thoại xác nhận;
  :Xóa và báo thành công;
  :Chọn thao tác;
endwhile ([Không])
if (Chọn sửa?) then ([Có])
else ([Không])
  if (Chọn thêm mới?) then ([Có])
