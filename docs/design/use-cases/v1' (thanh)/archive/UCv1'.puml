' ---------- General ----------
@startuml General
left to right direction
' skinparam shadowing false
' skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 70
skinparam packageStyle rectangle

actor "Người dùng" as USER
actor "Admin" as ADMIN
actor "Hệ thống định vị" as POSITIONING_SYSTEM

rectangle "Hệ thống thuyết minh tự động đa ngôn ngữ" {
  together {
    usecase "Tìm kiếm" as Search
    usecase "Chuyển đổi ngôn ngữ" as SwitchLanguage
    usecase "Xem hồ sơ bảo tàng" as ViewMuseumProfile
    usecase "Quét mã QR" as ScanQRCode
    usecase "Lưu sự vật yêu thích" as SaveFavoriteItem
    usecase "Nghe thuyết minh" as ListenToNarration
    usecase "Xem phụ đề" as ViewSubtitles
  }

  usecase "Đăng nhập" as Login

  together {
    usecase "Quản lý sự vật" as ManageItems
    usecase "Quản lý sơ đồ" as ManageFloorPlans
    usecase "Quản lý phiên" as ManageSessions
    usecase "Quản lý tệp âm thanh" as ManageAudioFiles
    usecase "Xem thống kê lượt nghe" as ViewListeningStatistics
    usecase "Định vị vị trí" as LocationTracking
  }
}

' ---- USER
USER -- Search
USER -- SwitchLanguage
USER -- ViewMuseumProfile
USER -- ScanQRCode
USER -- SaveFavoriteItem
USER -- ListenToNarration

' ---- ADMIN
ADMIN -- ManageItems
ADMIN -- ManageFloorPlans
ADMIN -- ManageSessions
ADMIN -- ManageAudioFiles
ADMIN -- ViewListeningStatistics

' ---- POSITIONING_SYSTEM
POSITIONING_SYSTEM -- LocationTracking

' ---- include / extend (all arrows: source → target)
ManageItems ..> Login : <<include>>
ManageFloorPlans ..> Login : <<include>>
ManageSessions ..> Login : <<include>>
ManageAudioFiles ..> Login : <<include>>
ViewListeningStatistics ..> Login : <<include>>

ViewSubtitles ..> ListenToNarration : <<extend>>
@enduml

