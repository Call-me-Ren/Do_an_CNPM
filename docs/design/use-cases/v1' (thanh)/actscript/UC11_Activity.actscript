ACTIVITY UC11 — Quản lý tệp âm thanh
PARTITION actor = {Admin, System*}

START                                          @Admin
[Chọn chức năng đăng nhập]                     @Admin
[Chào mừng đăng nhập cùng với hiển thị chức năng]
[Chọn Xem danh sách tệp]                       @Admin
[Hiển thị danh sách chức năng]


L1: [Chọn thao tác]                            @Admin
    IF (Chọn xoá?) THEN
        [Hộp thoại xác nhận]
        [Xoá và báo thành công]
        GOTO L1

    IF !(Chọn sửa hoặc thêm mới?) THEN FINAL

    [Hiển thị biểu mẫu]


L2: [Tải file lên]                             @Admin
    IF !(File hợp lệ?) THEN
        [Báo lỗi]
        GOTO L2


L3: [Xem trước, nhấn lưu]                      @Admin
    IF !(Lưu được?) THEN
        [Báo lỗi]
        GOTO L3

    [Cập nhật hồ sơ]
    FINAL
