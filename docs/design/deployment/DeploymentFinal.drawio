        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Theo quy chuan trinh bay V0 - Trien khai thuc te V3 (Web + Mobile APK + Docker + CI/CD 3 dich)\nskinparam linetype polyline\n\n&#39; ---------- Clients\ntogether {\n  node \&quot;Visitor / Admin Browser\&quot; &lt;&lt;device&gt;&gt; as WebDevice {\n    node \&quot;Browser Runtime\&quot; &lt;&lt;execution environment&gt;&gt; as BrowserRuntime {\n      artifact \&quot;React SPA (index.html + bundle)\&quot; &lt;&lt;artifact&gt;&gt; as WebSpa\n      artifact \&quot;Web Storage (Local / SessionStorage)\&quot; &lt;&lt;artifact&gt;&gt; as WebStorage\n    }\n  }\n\n  node \&quot;Android Smartphone\&quot; &lt;&lt;device&gt;&gt; as AndroidDevice {\n    node \&quot;Android OS / Hermes Runtime\&quot; &lt;&lt;execution environment&gt;&gt; as AndroidRuntime {\n      artifact \&quot;museum-audio-guide.apk\\n(Bundled Audio, Maps, Images)\&quot; &lt;&lt;artifact&gt;&gt; as MobileApk\n      artifact \&quot;AsyncStorage (Offline Cache &amp; Queue)\&quot; &lt;&lt;artifact&gt;&gt; as MobileStorage\n    }\n  }\n}\n\n&#39; ---------- Docker Host / Server\nnode \&quot;Docker Host (Server / Local)\&quot; &lt;&lt;device&gt;&gt; as DockerHost {\n  node \&quot;Nginx Container (:8080 -&gt; :80)\&quot; &lt;&lt;execution environment&gt;&gt; as NginxEnv {\n    artifact \&quot;Static Web + Reverse Proxy (/api, /uploads)\&quot; &lt;&lt;artifact&gt;&gt; as NginxArtifact\n  }\n\n  node \&quot;Node.js 20 Container (:4000)\&quot; &lt;&lt;execution environment&gt;&gt; as NodeEnv {\n    artifact \&quot;Express API (dist/index.js)\&quot; &lt;&lt;artifact&gt;&gt; as BackendApp\n  }\n\n  storage \&quot;Docker Volume (museum_uploads)\&quot; as UploadVol\n}\n\n&#39; ---------- Host Database &amp; External Services\ntogether {\n  node \&quot;Database Server (Host OS)\&quot; &lt;&lt;device&gt;&gt; as DbServer {\n    node \&quot;Microsoft SQL Server (:1433)\&quot; &lt;&lt;execution environment&gt;&gt; as MssqlEnv {\n      database \&quot;MuseumGuide DB (12 Tables)\&quot; &lt;&lt;database system&gt;&gt; as MuseumDb\n    }\n  }\n\n  node \&quot;External Translation APIs\&quot; &lt;&lt;device&gt;&gt; as TranslateCloud {\n    node \&quot;Cloud REST Endpoints\&quot; &lt;&lt;execution environment&gt;&gt; as TranslateApi {\n      artifact \&quot;Google Translate (translate.googleapis.com)\&quot; &lt;&lt;artifact&gt;&gt; as GoogleTrans\n      artifact \&quot;MyMemory Fallback (api.mymemory.translated.net)\&quot; &lt;&lt;artifact&gt;&gt; as MyMemoryTrans\n    }\n  }\n}\n\n&#39; ---------- CI/CD &amp; Distribution\ntogether {\n  node \&quot;GitHub Actions CI/CD\&quot; &lt;&lt;device&gt;&gt; as CiCdNode {\n    node \&quot;Ubuntu Runner\&quot; &lt;&lt;execution environment&gt;&gt; as RunnerEnv {\n      artifact \&quot;deploy.yml (Web + Backend CI / Pages)\&quot; &lt;&lt;artifact&gt;&gt; as WfPages\n      artifact \&quot;docker.yml (FE + BE Images)\&quot; &lt;&lt;artifact&gt;&gt; as WfDocker\n      artifact \&quot;mobile.yml (Jest + Gradle APK)\&quot; &lt;&lt;artifact&gt;&gt; as WfMobile\n    }\n  }\n\n  node \&quot;Distribution Targets\&quot; &lt;&lt;device&gt;&gt; as DistTargets {\n    artifact \&quot;GitHub Pages (Static Demo)\&quot; &lt;&lt;artifact&gt;&gt; as GhPages\n    artifact \&quot;GHCR (ghcr.io Docker Images)\&quot; &lt;&lt;artifact&gt;&gt; as Ghcr\n    artifact \&quot;GitHub Releases (APK)\&quot; &lt;&lt;artifact&gt;&gt; as GhRelease\n  }\n}\n\n&#39; ---------- Communication paths\nWebDevice -- NginxEnv : HTTPS / HTTP (:8080)\nAndroidDevice ..&gt; NginxEnv : HTTPS / REST (Optional Sync)\nAndroidDevice ..&gt; GhRelease : Download APK\nWebDevice ..&gt; GhPages : HTTPS (Demo Mode)\n\nNginxEnv -- NodeEnv : HTTP Proxy (:4000)\nNodeEnv -- UploadVol : Volume Mount (/app/uploads)\nNodeEnv -- MssqlEnv : TDS / TCP (:1433)\nNodeEnv ..&gt; TranslateApi : HTTPS / REST (Auto-Translate)\n\nCiCdNode ..&gt; GhPages : Deploy Static Web\nCiCdNode ..&gt; Ghcr : Push FE &amp; BE Images\nCiCdNode ..&gt; GhRelease : Attach APK\nDockerHost ..&gt; Ghcr : Pull Images (Optional)\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6VtZ8ZJ4Wo6XFaWFzztI-1">
