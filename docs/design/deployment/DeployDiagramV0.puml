@startuml
title Sơ Đồ Triển Khai (Deployment Diagram) - Hệ Thống Thuyết Minh Tự Động Đa Ngôn Ngữ (As-Built)
skinparam linetype ortho

' ---------- Thiết Bị Người Dùng & Quản Trị
node "Thiết Bị Khách Tham Quan (Smartphone / Tablet)" <<device>> as VisitorDevice {
  node "Mobile Browser Runtime (iOS Safari / Android Chrome)" <<execution environment>> as VisitorBrowser {
    artifact "React SPA (Visitor Bundle)" as VisitorBundle
    database "LocalStorage & SessionStorage" as VisitorStorage
  }
}

node "Máy Tính Quản Trị Viên (Admin Workstation)" <<device>> as AdminDevice {
  node "Desktop Browser (Chrome / Edge / Firefox)" <<execution environment>> as AdminBrowser {
    artifact "React SPA (Admin Dashboard Bundle)" as AdminBundle
    database "SessionStorage (Admin Token)" as AdminStorage
  }
}

' ---------- Hạ Tầng CI/CD Build
node "GitHub Actions Runner (Ubuntu Latest)" <<device>> as CiCdRunner {
  node "Node.js 20 Build Runtime" <<execution environment>> as NodeRuntime {
    artifact "Vite 6 + TailwindCSS v4 Compiler" as Compiler
    artifact "Static Dist Generator" as DistGen
  }
}

' ---------- Hạ Tầng Phân Phối Tĩnh (Hosting)
node "GitHub Pages Global CDN / Edge Servers" <<device>> as GhPagesEdge {
  node "HTTPS Static Web Server" <<execution environment>> as StaticWebServer {
    artifact "index.html & assets/index.js & assets/index.css" as WebAssets
    artifact "museum_data.json (Mock CSDL Hiện Vật)" as MockDb
    artifact "audio/artifacts/*.mp3 (Kho Lưu Tệp Âm Thanh)" as AudioArchive
    artifact "maps/*.png, *.jpg (Kho Ảnh Sơ Đồ 4 Tầng)" as MapArchive
    artifact "images/artifacts/* (Kho Ảnh Hiện Vật)" as ImgArchive
  }
}

' ---------- Kênh Dữ Liệu Thời Gian Thực
node "ntfy.sh Realtime Cloud Service" <<device>> as NtfyCloud {
  node "WebSocket & SSE Message Broker" <<execution environment>> as BrokerEnv {
    queue "Topic: wrm_museum_presence_cnpm" as PresenceQueue
  }
}

' ---------- Các Tuyến Giao Tiếp
VisitorDevice -down-> GhPagesEdge : "HTTPS GET / (Tải Bundle, JSON, Ảnh, Audio Stream)"
AdminDevice -down-> GhPagesEdge : "HTTPS GET /admin (Tải Bundle Quản Trị, CSDL)"

VisitorDevice <--> NtfyCloud : "WebSocket / HTTPS POST (Gửi Heartbeat & Sự Kiện Nghe)"
AdminDevice <--> NtfyCloud : "WebSocket Subscribe (Cập Nhật Thiết Bị Trực Tuyến Tức Thì)"

CiCdRunner -right-> GhPagesEdge : "GitHub Actions Deploy Pages Artifact (Automated CI/CD)"
@enduml
