@startuml
skinparam linetype polyline

' ---------- Client
node "Client PC" <<device>> as ClientPC {
  node "Browser / App Runtime" <<execution environment>> as BrowserRuntime {
    artifact "GUI.spa" <<artifact>> as GuiSpa
    artifact "ClientSession.js" <<artifact>> as ClientSessionJs
    artifact "QRScanner.js" <<artifact>> as QrScannerJs
    artifact "MediaPlayer.js" <<artifact>> as MediaPlayerJs
  }
}

' ---------- Application server
node "Application Server" <<device>> as ApplicationServer {
  node "Docker / JVM" <<execution environment>> as DockerJvm {
    artifact "AuthServer.jar" <<artifact>> as AuthServerJar
    artifact "ArtifactManager.jar" <<artifact>> as ArtifactManagerJar
    artifact "AudioStreamer.jar" <<artifact>> as AudioStreamerJar
  }
}

' ---------- Database and media storage
together {
  node "Database Server" <<device>> as DatabaseServer {
    node "DBMS Engine" <<execution environment>> as DbmsEngine {
      database "System DB" <<database system>> as SystemDb
    }
  }

  node "Media Storage Server" <<device>> as MediaStorageServer {
    node "File Storage Service" <<execution environment>> as FileStorageService {
      artifact "MediaArchive.storage" <<artifact>> as MediaArchiveStorage
    }
  }
}

' ---------- Communication paths
ClientPC -right- ApplicationServer : HTTPS / REST API
ApplicationServer -right- DatabaseServer : JDBC / TCP
ApplicationServer -right- MediaStorageServer : HTTP / REST API

' Layout only: place the media server below the database server
DatabaseServer -[hidden]down- MediaStorageServer
@enduml
