@startuml
left to right direction

' ---------- Client
component "Client" as Client {
  component "GUI" as Gui
  together {
    component "Media Player" as MediaPlayer
    component "QR Scanner" as QrScanner
    component "Client Session" as ClientSession
  }

  portout " " as ClientPortAuth
  portout " " as ClientPortArtifactSession
  portout " " as ClientPortArtifactQr
  portout " " as ClientPortAudio
}

' ---------- Server
component "Server" as Server {
  together {
    component "Auth Server" as AuthServer
    component "Artifact Manager" as ArtifactManager
    component "Audio Streamer" as AudioStreamer
  }

  portin " " as ServerPortAuth
  portin " " as ServerPortArtifact
  portin " " as ServerPortAudio

  portout " " as ServerPortDb
  portout " " as ServerPortStorage
}

' ---------- Storage & DB
component "Storage & DB" as Storage {
  together {
    component "System DB" as SystemDb
    component "Media Archive" as MediaArchive
  }

  portin " " as StoragePortDb
  portin " " as StoragePortStorage
}

' ---------- Interfaces
() "I_Auth" as IAuth
() "I_Artifact" as IArtifact
() "I_Audio" as IAudio
() "I_Database" as IDatabase
() "I_Storage" as IStorage

' ---- Client internals
Gui -- ClientSession
Gui -- QrScanner
Gui -- MediaPlayer

ClientSession -- ClientPortAuth
ClientSession -- ClientPortArtifactSession
QrScanner -- ClientPortArtifactQr
MediaPlayer -- ClientPortAudio

' ---- Client → Server
ClientPortAuth --( IAuth
ClientPortArtifactSession ..( IArtifact
ClientPortArtifactQr ..( IArtifact
ClientPortAudio --( IAudio

IAuth -- ServerPortAuth
IArtifact -- ServerPortArtifact
IAudio -- ServerPortAudio

ServerPortAuth -- AuthServer
ServerPortArtifact -- ArtifactManager
ServerPortAudio -- AudioStreamer

' ---- Server → Storage
AuthServer -- ServerPortDb
ArtifactManager -- ServerPortDb
ArtifactManager -- ServerPortStorage
AudioStreamer -- ServerPortStorage

ServerPortDb ..( IDatabase
ServerPortStorage ..( IStorage

IDatabase -- StoragePortDb
IStorage -- StoragePortStorage

StoragePortDb -- SystemDb
StoragePortStorage -- MediaArchive
@enduml