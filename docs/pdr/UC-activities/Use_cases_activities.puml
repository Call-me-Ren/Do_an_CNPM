' ---------- UC01_activity ----------
@startuml UC01_activity
title UC01 - Đăng ký
start
:Người dùng chọn chức năng đăng ký;
:Hệ thống hiển thị biểu mẫu đăng ký;
repeat
  :Nhập thông tin;
  if (Chọn hủy hay xác nhận?) then (Hủy)
    :Hủy và quay lại;
    stop
  else (Xác nhận)
  endif
  :Kiểm tra thông tin;
backward :Báo lỗi;
repeat while (Dữ liệu hợp lệ?) is (Không) not (Có)
if (Tài khoản đã tồn tại?) then (Có)
  :Vào trang đăng nhập;
  detach
else (Không)
  :Khởi tạo tài khoản;
  :Chuyển hướng trang;
endif
stop
@enduml

