' ---------- UC02_activity ----------
@startuml UC02_activity
title UC02 - Đăng nhập
start
:Tác nhân chọn chức năng đăng nhập;
:Hệ thống hiển thị biểu mẫu đăng nhập;
if (Quên mật khẩu?) then (Có)
  :Nhập thông tin để đổi mật khẩu;
  detach
else (Không)
endif
repeat
  :Nhập thông tin;
  :Xác thực đăng nhập;
  if (Tài khoản tồn tại?) then (Có)
    if (Mật khẩu đúng?) then (Có)
    else (Không)
      :Hiển thị thông báo mật khẩu sai;
    endif
  else (Không)
    :Hiển thị thông báo tài khoản không tồn tại;
  endif
repeat while (Đăng nhập thành công?) is (Không) not (Có)
:Khởi động phiên làm việc;
if (Vai trò là gì?) then (Admin)
  :Hiển thị dashboard quản trị;
else (Người dùng)
  :Hiển thị trang cá nhân;
endif
stop
@enduml

