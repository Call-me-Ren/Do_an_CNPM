{
  "expo": {
    "name": "Museum Audio Guide",
    "slug": "museum-audio-guide",
    "scheme": "museumguide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần quyền Camera để quét mã QR hiện vật trong bảo tàng.",
        "NSLocationWhenInUseUsageDescription": "Ứng dụng cần quyền vị trí để tự động nhận diện hiện vật gần bạn."
      }
    },
    "android": {
      "package": "vn.edu.sgu.museumguide",
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần quyền Camera để quét mã QR hiện vật trong bảo tàng."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ứng dụng cần quyền vị trí để tự động nhận diện hiện vật gần bạn."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ]
  }
}
